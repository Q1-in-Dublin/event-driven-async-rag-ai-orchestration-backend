# Comments start with '#'

# Ignore specific files
PRD.md
TDD.md
what_I_learnt.md

# Ignore specific directories
build/
.serena/

# Python bytecode cache
__pycache__/
*.pyc

# Ignore all .log files
*.log

# Ignore .DS_Store files in any directory
**/.DS_Store

# Ignore specific extensions - e.g. all .class files
*.class

# Secrets / local environment
.env

# Use '!' to re-include a specific file that would otherwise be ignored
!.vscode/tasks.json